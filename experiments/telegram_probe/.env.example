# Obtain the token only from @BotFather. Never commit or paste it into reports.
TELEGRAM_BOT_TOKEN=replace-locally
# Comma-separated signed numeric IDs. Start in discovery mode to learn them.
PROBE_ALLOWED_CHAT_IDS=-1001234567890
PROBE_OPERATOR_USER_IDS=123456789
# Keep low: this is an experiment, not a bulk sender.
PROBE_CHUNK_SIZE=2
PROBE_CHUNK_DELAY_SECONDS=3
PROBE_LOG_LEVEL=INFO
